    "phase12:seed": "node --env-file-if-exists=.env.phase12.local scripts/phase12/seed-e2e-fixtures.mjs",
    "phase12:cleanup": "node --env-file-if-exists=.env.phase12.local scripts/phase12/cleanup-e2e-fixtures.mjs",
    "phase12:scan-artifacts": "node scripts/phase12/scan-e2e-artifacts.mjs",
    "phase12:staging-result": "node scripts/phase12/staging-browser-smoke.mjs",
    "phase12:verify-release": "node scripts/phase12/verify-release-evidence.mjs",
    "phase12:production-smoke": "node scripts/phase12/production-post-release-smoke.mjs",
    "phase12:production-auth-smoke": "node scripts/phase12/production-auth-readonly-smoke.mjs",
    "phase13:discover": "node scripts/phase13/discover-evidence.mjs",
    "phase13:normalize": "node scripts/phase13/build-offline-baseline.mjs",
    "phase13:validate": "node scripts/phase13/validate-phase13-schemas.mjs",
    "phase13:test": "node --test tests/phase13/*.test.mjs",
    "phase13:verify": "node scripts/phase13/verify-phase13-repository.mjs",
    "phase13:normalize-production-export": "node scripts/phase13/normalize-production-export.mjs",
    "phase13:compare-production-export": "node scripts/phase13/compare-production-export.mjs",
    "phase14:generate": "node scripts/phase14/generate-gate1-outputs.mjs",
    "phase14:dry-run": "node scripts/phase14/generate-gate1-outputs.mjs",
    "phase14:validate": "node scripts/phase14/validate-phase14-schemas.mjs",
    "phase14:test": "node --test tests/phase14/*.test.mjs",
    "phase14:verify": "node scripts/phase14/verify-phase14-gate1.mjs",
