{
  "name": "march-out-for-love",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "nuxt cleanup",
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "typecheck": "nuxi typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "generate": "nuxt generate",
    "preview": "nuxt preview --host=0.0.0.0",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:coverage": "nuxi prepare && vitest run --project unit --project components --coverage",
    "test:integration": "node scripts/phase11/local-ssr-smoke.mjs",
    "phase11:verify": "node scripts/phase11/verify-repository.mjs",
    "phase11:audit": "pnpm audit --prod --audit-level=high",
    "test:phase11": "pnpm run phase11:verify && pnpm run lint && pnpm run phase11:audit && pnpm run test:coverage && pnpm run typecheck && pnpm run test:phase10 && pnpm run build && pnpm run test:integration",
    "test:phase5": "node --env-file-if-exists=.env.phase6.local scripts/phase5-auth-smoke.mjs",
    "test:phase6": "node --env-file-if-exists=.env.phase6.local scripts/phase6-admin-crud-smoke.mjs",
    "test:phase7": "node --env-file-if-exists=.env.phase6.local scripts/phase7-admin-access-smoke.mjs",
    "test:phase8": "node --env-file-if-exists=.env.phase6.local scripts/phase8-core-content-smoke.mjs",
    "phase9:discover": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/discover-sources.mjs",
    "phase9:inventory": "node scripts/phase9/build-real-manifests.mjs",
    "phase9:normalize": "node scripts/phase9/build-real-manifests.mjs",
    "phase9:dry-run": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/migrate-real.mjs --mode=dry-run",
    "phase9:dry-run:synthetic": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/migrate-content.mjs --mode=dry-run --synthetic",
    "phase9:apply": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/migrate-real.mjs --mode=apply",
    "phase9:apply:synthetic": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/migrate-content.mjs --mode=apply --synthetic",
    "phase9:resume": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/migrate-real.mjs --mode=resume",
    "phase9:resume:synthetic": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/migrate-content.mjs --mode=resume --synthetic",
    "phase9:verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/verify-real.mjs",
    "phase9:verify:synthetic": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/verify-migration.mjs",
    "phase9:rollback-test": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/rollback-test.mjs",
    "phase9:cleanup-scan": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase9.local --env-file-if-exists=.env.phase6.local scripts/phase9/cleanup-scan.mjs",
    "test:phase9": "node scripts/phase9/run-full-test.mjs",
    "phase10:backup:inventory": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase6.local --env-file-if-exists=.env.phase10.local scripts/phase10/backup-checkpoint.mjs --mode=inventory",
    "phase10:backup:checkpoint": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase6.local --env-file-if-exists=.env.phase10.local scripts/phase10/backup-checkpoint.mjs --mode=checkpoint",
    "phase10:backup:restore": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase6.local --env-file-if-exists=.env.phase10.local scripts/phase10/backup-checkpoint.mjs --mode=restore-rehearsal",
    "phase10:restore:verify": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase6.local --env-file-if-exists=.env.phase10.local scripts/phase10/verify-restored-database.mjs",
    "phase10:decisions": "node scripts/phase10/build-decision-manifests.mjs",
    "phase10:bootstrap:dry-run": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase6.local --env-file-if-exists=.env.phase10.local scripts/phase10/bootstrap-editorial.mjs --mode=dry-run",
    "phase10:bootstrap:apply": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase6.local --env-file-if-exists=.env.phase10.local scripts/phase10/bootstrap-editorial.mjs --mode=apply",
    "phase10:decisions:dry-run": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase6.local --env-file-if-exists=.env.phase10.local scripts/phase10/apply-conservative-decisions.mjs --mode=dry-run",
    "phase10:redirect:generate": "node scripts/phase10/generate-redirect-config.mjs --mode=dry-run",
    "phase10:redirect:verify": "node scripts/phase10/verify-redirects.mjs --mode=static",
    "phase10:redirect:verify:http": "node scripts/phase10/verify-redirects.mjs --mode=http",
    "phase10:privacy": "node scripts/phase10/privacy-fixture-test.mjs",
    "phase10:static": "node scripts/phase10/static-verify.mjs",
    "phase10:synthetic": "node scripts/phase10/synthetic-check.mjs",
    "test:phase10:smoke": "node --env-file-if-exists=.env --env-file-if-exists=.env.phase10.local --env-file-if-exists=.env.phase6.local scripts/phase10/smoke-read-only.mjs",
    "test:phase10": "pnpm run phase10:static && pnpm run phase10:redirect:verify && pnpm run phase10:privacy"
  },
  "dependencies": {
    "@nuxtjs/tailwindcss": "6.14.0",
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "h3": "1.15.11",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^3.21.10",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.16.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.10",
    "@vue/test-utils": "2.4.11",
    "eslint": "10.8.0",
    "happy-dom": "20.11.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vitest": "4.1.10",
    "vue-tsc": "^3.3.7"
  }
}
