{
  "name": "march-out-for-love",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "predev": "nuxt cleanup",
    "dev": "nuxt dev --host 0.0.0.0",
    "build": "nuxt build",
    "typecheck": "nuxi typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "generate": "nuxt generate",
    "preview": "nuxt preview --host=0.0.0.0",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:components": "vitest run --project components",
    "test:coverage": "nuxi prepare && vitest run --project unit --project components --coverage",
    "test:application": "nuxi prepare && vitest run --config vitest.application.config.ts --coverage",
    "test:integration": "node scripts/phase11/local-ssr-smoke.mjs",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:staging": "nuxi prepare && playwright test",
    "test:e2e:report": "playwright show-report",
    "phase11:verify": "node scripts/phase11/verify-repository.mjs",
    "phase11:audit": "pnpm audit --prod --audit-level=high",
    "test:phase11": "pnpm run phase11:verify && pnpm run lint && pnpm run phase11:audit && pnpm run test:coverage && pnpm run typecheck && pnpm run test:phase10 && pnpm run build && pnpm run test:integration",
    "phase12:verify": "node scripts/phase12/verify-phase12-repository.mjs",
    "phase12:verify-staging-approval": "node scripts/phase12/verify-staging-approval.mjs",
