{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://marchout.example.invalid/schemas/phase10-release-manifest.json",
  "title": "Phase 10 explicit release batch",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourceSnapshotSha256", "batchKey", "requestedAction", "items"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sourceSnapshotSha256": { "const": "3a6a00bcd5a5b8030ab5da6b61cd597f2df4c0762edb46dd9f8655e003cceb60" },
    "batchKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" },
    "requestedAction": { "const": "publish" },
    "safetyCheckpointKey": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 70,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceKey", "targetKind", "targetId", "reviewKeys", "expectedTargetVersion", "redirectKeys"],
        "properties": {
          "sourceKey": { "type": "string", "pattern": "^wix:[A-Za-z0-9:._-]+$" },
          "targetKind": { "enum": ["activity", "file", "year-summary"] },
          "targetId": { "type": "string", "format": "uuid" },
          "reviewKeys": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^P9-[0-9]{4}$" }
          },
          "expectedTargetVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
          "redirectKeys": {
            "type": "array", "maxItems": 52, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^R9-[0-9a-f]{24}$" }
          }
        }
      }
    }
  }
}
